{
  "name": "backend",
  "version": "2.0.3",
  "description": "Backend server for Top4CryptoShop",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "echo 'Hooks installation disabled' && exit 0",
    "build": "echo 'No build required' && exit 0",
    "postinstall": "echo 'Installation completed'"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "compression": "^1.8.1",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.0",
    "morgan": "^1.10.1",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "eslint": "^9.32.0",
    "glob": "^11.0.3",
    "jest": "^30.0.5",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "rimraf": "6.0.1"
  },
  "config": {
    "ignore-scripts": true
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
