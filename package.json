{
  "name": "top4cryptoshop",
  "version": "1.0.0",
  "description": "A cryptocurrency shop application",
  "main": "backend/server.js",
  "scripts": {
    "start": "cd backend && node server.js",
    "dev": "cd backend && nodemon server.js",
    "backend-install": "cd backend && npm install",
    "frontend-install": "cd frontend && npm install",
    "install-all": "npm run backend-install && npm run frontend-install",
    "test": "jest"
  },
  "dependencies": {
    "concurrently": "^7.6.0",
    "googleapis": "^159.0.0"
  },
  "keywords": [
    "cryptocurrency",
    "shop",
    "nodejs",
    "express"
  ],
  "author": "Top4CryptoShop Team",
  "license": "MIT",
  "devDependencies": {
    "jest": "^30.0.5"
  },
  "overrides": {
    "shell-quote@^1.0.0": "1.12.0",
    "jws@^4.0.0": "4.0.1",
    "lodash@^4.0.0": "4.18.1",
    "browserslist@^4.0.0": "4.28.7",
    "baseline-browser-mapping@^2.0.0": "2.11.0",
    "glob@^10.0.0": "10.5.0",
    "js-yaml@^3.0.0": "3.15.2",
    "minimatch@^9.0.0": {
      ".": "9.0.9",
      "brace-expansion": "2.1.7"
    },
    "minimatch@^3.0.0": {
      ".": "3.1.5",
      "brace-expansion": "1.1.21"
    },
    "picomatch@^2.0.0": "2.3.2",
    "picomatch@^4.0.0": "4.0.7",
    "qs@^6.0.0": "6.16.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvanBrazi/Top4CryptoShop.git"
  },
  "bugs": {
    "url": "https://github.com/EvanBrazi/Top4CryptoShop/issues"
  },
  "homepage": "https://github.com/EvanBrazi/Top4CryptoShop#readme"
}
